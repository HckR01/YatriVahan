NODE_ENV=development
PORT=4000

# Comma-separated browser origins. Use * only for local development without credentials.
CLIENT_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Project Settings -> API in Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Keep this key on the backend only. Never expose it through VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Realtime controls.
SOCKET_LOCATION_MIN_INTERVAL_MS=1000
SOCKET_MAX_CONNECTIONS_PER_USER=5
# Verified driver/offerer approval is mandatory in every environment.
REQUIRE_DRIVER_VERIFICATION=true

# /admine login. Leave unset to disable. Generate a salted hash using npm run admin:password.
ADMIN_USERNAME=replace-with-your-admin-id
# ADMIN_PASSWORD_HASH=salt:hash

